{
  "name": "daily-tarot",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "[email protected]",
  "scripts": {
    "dev": "astro dev",
    "start": "node scripts/dev.mjs",
    "build": "astro build",
    "postbuild": "node scripts/copy-functions.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "dev:full": "node scripts/dev.mjs",
    "dev:astro": "astro dev",
    "dev:functions": "wrangler pages dev ./dist --port 8788",
    "deploy": "astro build && wrangler pages deploy ./dist",
    "deploy:check": "astro check && astro build",
    "typecheck": "astro check",
    "admin": "astro dev",
    "post:daily": "node scripts/daily-card.mjs",
    "post:daily:publish": "node scripts/daily-card.mjs --publish",
    "post:daily:commit": "node scripts/daily-card.mjs --commit",
    "post:new": "node scripts/new-post.mjs",
    "post:new:commit": "node scripts/new-post.mjs --commit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.0.3",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.0.5",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^12.2.1",
    "@types/node": "^22.10.1",
    "wrangler": "^4.127.0"
  }
}
