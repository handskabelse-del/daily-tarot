# Public vars (exposed to client, safe to commit)
PUBLIC_GA_ID=
PUBLIC_ADSENSE_CLIENT_ID=

# Server secrets — set with `wrangler secret put NAME` for production
COOKIE_SECRET=dev-fallback-cookie-secret-change-me
SITE_URL=https://dailytarot.example.com
OPENROUTER_MODEL=openrouter/auto

# Toggle daily readings on/off (true|false). When true, /api/reading returns 503.
READINGS_PAUSED=true
