# =============================================================
# .env.example — Astro/Vite public client-side vars
# -------------------------------------------------------------
# Copy to `.env` for local dev (Astro reads this for PUBLIC_*
# vars and inlines them into the client bundle at build time).
#
# This file is SAFE TO COMMIT — only PUBLIC_* vars live here.
# All secrets (COOKIE_SECRET, OPENROUTER_DEFAULT_KEY, etc.) go
# in `.dev.vars` instead (the Wrangler convention).
# =============================================================


# -----------------------------
# Public client-side vars
# -----------------------------
# Both are read by src/components/* (AdSlot, SeoHead) and inlined
# into the bundle. Leave blank to disable the corresponding feature.

# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX".
# When empty, the GA script tag is not rendered.
PUBLIC_GA_ID=

# Google AdSense publisher ID, e.g. "ca-pub-1234567890123456".
# When empty, ad slots render as blank placeholders.
PUBLIC_ADSENSE_CLIENT_ID=
