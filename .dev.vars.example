# =============================================================
# .dev.vars.example — template for `.dev.vars`
# -------------------------------------------------------------
# Copy this file to `.dev.vars` and fill in real values for local
# dev. `.dev.vars` is gitignored.
#
# In production, the same vars are set in the Cloudflare Pages
# dashboard -> Settings -> Variables and Secrets:
#   - Non-secret values go under "Environment variables".
#   - Secret values (anything that looks like a key) go under
#     "Secrets" and are injected as `env.<NAME>` to functions.
#
# See the matching comment blocks in `.dev.vars` for context on
# what each variable does and which file reads it.
# =============================================================

# Cloudflare Functions — runtime --------------------------------

SITE_URL=http://localhost:4321
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
READINGS_PAUSED=false

COOKIE_SECRET=replace-with-a-long-random-string
OPENROUTER_DEFAULT_KEY=sk-or-v1-replace-with-your-key


# CLI / GitHub Actions — local only -----------------------------

DAILY_DRAFT_COUNT=7
# GIT_AUTHOR_NAME=Daily Tarot Bot
# GIT_AUTHOR_EMAIL=bot@dailytarot.local