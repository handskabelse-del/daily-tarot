---
export interface Props {
  title: string;
  description?: string;
  path?: string;
  locale?: 'en' | 'es' | 'fr';
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  availableLocales?: Array<'en' | 'es' | 'fr'>;
}
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import MobileMenu from '../components/MobileMenu.astro';
import MobileMenuButton from '../components/MobileMenuButton.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import Toast from '../components/Toast.astro';
import { websiteJsonLd } from '../lib/seo';
const { title, description, path, locale, type, image, noindex, jsonLd, availableLocales } = Astro.props;
const allJsonLd = [websiteJsonLd(), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const gaId = import.meta.env.PUBLIC_GA_ID;
---
<!doctype html>
<html lang={locale || 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07070d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <SeoHead title={title} description={description} path={path} locale={locale} type={type} image={image} noindex={noindex} jsonLd={allJsonLd} availableLocales={availableLocales} />
    {gaId && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    )}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId, { anonymize_ip: true });
      </script>
    )}
    {import.meta.env.PUBLIC_ADSENSE_CLIENT_ID && (
      <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js" crossorigin="anonymous" data-consent="true"></script>
    )}
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="g" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
                <stop stop-color="#b89cff" />
                <stop offset="1" stop-color="#6ad6c9" />
              </linearGradient>
            </defs>
            <circle cx="16" cy="16" r="14" stroke="url(#g)" stroke-width="1.5" />
            <path d="M16 6 L20 14 L28 16 L20 18 L16 26 L12 18 L4 16 L12 14 Z" fill="url(#g)" />
          </svg>
          <span>Daily Tarot</span>
        </a>
        <nav class="nav nav-desktop" aria-label="Primary">
          <a href="/">Reading</a>
          <a href="/card-of-the-day">Card of the day</a>
          <a href="/tarot-card-meanings">Card meanings</a>
          <a href="/blog">Blog</a>
          <a href="/es/">ES</a>
          <a href="/fr/">FR</a>
        </nav>
        <MobileMenuButton />
      </div>
    </header>
    <!-- Drawer + backdrop live at body level so they don't get trapped
         inside the header's z-index stacking context. -->
    <MobileMenu />
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Daily Tarot. For entertainment only.</span>
        <div class="footer-links">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/disclaimer">Disclaimer</a>
        </div>
      </div>
    </footer>
    <ConsentBanner />
    <Toast />
  </body>
</html>
