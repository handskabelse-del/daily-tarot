---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbJsonLd, blogJsonLd } from '../../lib/seo';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ]),
  blogJsonLd({
    path: '/blog',
    posts: posts.map((p) => ({
      title: p.data.title,
      path: `/blog/${p.slug}`,
      date: p.data.date.toISOString(),
      description: p.data.description,
    })),
  }),
];
// Inline ad rendering. Astro components passed as direct children to a layout's
// <slot/> were being silently dropped on this codebase, so we render the
// ad-slot markup directly here. When `PUBLIC_ADSENSE_CLIENT_ID` is set we
// emit the real AdSense <ins> tag; otherwise we show a labelled placeholder.
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || '';
const topAdSlotId = '1111111111';
const infeedAdSlotId = '2222222222';
const renderAd = (position: 'top' | 'infeed') => adsenseClient
  ? `<ins class="adsbygoogle ad-slot" data-ad-client="${adsenseClient}" data-ad-slot="${position === 'top' ? topAdSlotId : infeedAdSlotId}" data-ad-format="${position === 'top' ? 'auto' : 'fluid'}" data-full-width-responsive="true" style="display:block"></ins>`
  : `<div class="ad-slot" aria-label="Advertisement placeholder"><span class="ad-slot-label">Advertisement</span></div>`;
const topAdHtml = renderAd('top');
const infeedAdHtml = renderAd('infeed');
const hasAdsense = !!adsenseClient;
---
<BaseLayout
  title="Tarot Blog — Daily Insights, Spreads, and Card Meanings"
  description="Articles on tarot card meanings, spreads, daily practice, and intuition. Updated weekly."
  path="/blog"
  jsonLd={jsonLd}
>
  <article class="prose">
    <h1>Tarot Blog</h1>
    <p>Articles on reading tarot, the cards themselves, and building a daily practice.</p>
  </article>

  <div class="ad-slot-wrapper" data-ad-slot="top" data-has-adsense={String(hasAdsense)} set:html={topAdHtml} />

  <div class="blog-grid">
    {posts.map((p, i) => (
      <Fragment>
        <article class="blog-card">
          <a href={`/blog/${p.slug}`}>
            {p.data.category && (
              <div style="font-size:0.75rem;color:var(--accent-2);text-transform:uppercase;letter-spacing:0.1em">
                {p.data.category}
              </div>
            )}
            <h3>{p.data.title}</h3>
            <p style="font-size:0.95rem;color:var(--fg-1)">{p.data.description}</p>
          </a>
          <div class="meta">
            <time datetime={p.data.date.toISOString()}>
              {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </div>
        </article>
        {(i + 1) % 3 === 0 && i !== posts.length - 1 && (
          <div class="blog-grid-ad">
            <div data-ad-slot="infeed" data-has-adsense={String(hasAdsense)} set:html={infeedAdHtml} />
          </div>
        )}
      </Fragment>
    ))}
  </div>
</BaseLayout>
