---
---
<div class="consent-banner" id="consent-banner" role="dialog" aria-label="Cookie consent">
  <p>
    We use cookies for ads and analytics to keep this site free.
    <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a>
  </p>
  <div class="actions">
    <button class="btn btn-secondary" id="consent-reject" type="button">Reject</button>
    <button class="btn" id="consent-accept" type="button">Accept</button>
  </div>
</div>
<script>
  (function () {
    const KEY = 'dt_consent';
    const banner = document.getElementById('consent-banner');
    if (!banner) return;
    const stored = localStorage.getItem(KEY);
    if (stored === 'accepted') {
      banner.remove();
      window.dispatchEvent(new CustomEvent('dt:consent-accepted'));
    } else if (stored === 'rejected') {
      banner.remove();
    } else {
      banner.hidden = false;
      // Add a class on <body> so the page can add bottom padding while
      // the banner is on screen (the banner is position:fixed and would
      // otherwise cover the bottom of the page, including the "Get my
      // reading" button on mobile).
      document.body.classList.add('consent-banner-active');
    }
    document.getElementById('consent-accept')?.addEventListener('click', () => {
      localStorage.setItem(KEY, 'accepted');
      banner.remove();
      document.body.classList.remove('consent-banner-active');
      window.dispatchEvent(new CustomEvent('dt:consent-accepted'));
      try {
        const w = window as unknown as { adsbygoogle?: unknown[] };
        (w.adsbygoogle = w.adsbygoogle || []).push({});
      } catch (_) {}
    });
    document.getElementById('consent-reject')?.addEventListener('click', () => {
      localStorage.setItem(KEY, 'rejected');
      banner.remove();
      document.body.classList.remove('consent-banner-active');
    });
  })();
</script>
