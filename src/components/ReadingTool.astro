---
import { t } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import AdSlot from './AdSlot.astro';

export interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const dict = t(locale);
---
<section class="reading-tool" id="reading-tool" data-locale={locale}>
  <AdSlot slot="top" />

  <div class="stage" id="stage" data-state="intro">
    <div class="stage-avatar" id="stage-avatar" aria-hidden="true">
      <img src="/assets/witch.png" alt="" loading="eager" decoding="async" />
      <div class="avatar-veil"></div>
    </div>

    <div class="stage-cards" id="stage-cards">
      <div class="cta-wrap" data-state-panel="intro">
        <h1 class="hero-title">{dict.heroTitle}</h1>
        <div class="card-grid-shell">
          <div class="card-grid" id="card-grid">
            {Array.from({ length: 9 }).map(() => (
              <div class="tarot-card tarot-card-static">
                <div class="tarot-card-inner">
                  <div class="tarot-card-face tarot-card-back">
                    <img src="/assets/cards/back.jfif" alt="" loading="lazy" decoding="async" />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="controls controls-cta" id="intro-cta">
          <button class="btn btn-ghost" id="draw-btn" type="button">{dict.ctaGetReading}</button>
        </div>
        <p class="disclaimer">For entertainment only. No medical, legal, or financial advice.</p>
      </div>
    </div>

    <div class="stage-loading" id="stage-loading" data-state-panel="loading" hidden>
      <div class="loading-bubble">
        <span class="spinner"></span>
        <span>Shuffling the deck…</span>
      </div>
    </div>

    <div class="stage-reading" id="stage-reading" data-state-panel="reading" hidden>
      <div class="reading-topbar">
        <span class="remaining-pill" id="remaining-pill">
          <span class="dot"></span>
          <span id="remaining-text">2/2 rejections left</span>
        </span>
      </div>
      <article class="reading-narrative" id="reading-narrative" aria-live="polite"></article>
      <div class="controls controls-cta" id="reading-controls">
        <button class="btn btn-ghost" id="reject-btn" type="button">{dict.ctaReject}</button>
        <button class="btn btn-ghost" id="accept-btn" type="button">{dict.ctaAccept}</button>
      </div>
      <div class="locked-cta" id="locked-cta" hidden>
        <button class="btn btn-ghost" type="button" disabled>{dict.lockedCta}</button>
      </div>
      <p class="powered-by">
        Interpretations generated by <a href="https://openrouter.ai/nvidia" rel="noopener noreferrer" target="_blank">NVIDIA Nemotron</a>
        via <a href="https://openrouter.ai" rel="noopener noreferrer" target="_blank">OpenRouter</a>. Powered by Daily Tarot.
      </p>
    </div>

    <div class="stage-actions" id="stage-actions" data-state-panel="reading-actions" hidden>
      <AdSlot slot="infeed" />
    </div>

    <div class="stage-accepted" id="stage-accepted" data-state-panel="accepted" hidden>
      <div class="accepted-bubble">
        <h2>Saved.</h2>
        <p>Carry this reading gently today. Come back tomorrow for a fresh draw.</p>
        <div class="accepted-countdown">
          <span class="lbl">Tomorrow's draw in</span>
          <span class="num" id="accepted-countdown">00:00:00</span>
        </div>
      </div>
    </div>
  </div>
</section>

<dialog id="reject-confirm" class="modal">
  <h3>Reject this reading?</h3>
  <p>You'll use one of your two daily rejections. After two rejections, no new readings until tomorrow.</p>
  <div class="controls controls-cta">
    <button class="btn btn-ghost" id="reject-cancel" type="button" value="cancel">Keep it</button>
    <button class="btn btn-ghost" id="reject-confirm-btn" type="button" value="confirm">Yes, draw again</button>
  </div>
</dialog>

<script>
  type State = 'intro' | 'loading' | 'reading' | 'locked' | 'accepted';
  type DrawCard = {
    id: string;
    card: { id: string; name: string; arcana: string; suit?: string; keywords: string[] };
    orientation: 'upright' | 'reversed';
    position: { index: number; name: string; prompt: string };
  };
  type Reading = {
    summary?: string;
    story?: string;
    positionInterpretations?: Array<{
      position: string;
      card: string;
      orientation: 'upright' | 'reversed';
      text: string;
    }>;
    advice?: string;
  };

    const IMAGE_BY_ID: Record<string, string> = {
      'major-0': '/assets/cards/0-The-Fool.jfif',
      'major-1': '/assets/cards/1-the-magician.jfif',
      'major-2': '/assets/cards/2-the-high-priestess.jfif',
      'major-3': '/assets/cards/3-the-empress.jfif',
      'major-4': '/assets/cards/4-the-emperor.jfif',
      'major-5': '/assets/cards/5-hierophant.jfif',
      'major-6': '/assets/cards/6-the-lovers.jfif',
      'major-7': '/assets/cards/7-the-chariot.jfif',
      'major-8': '/assets/cards/8-Strength.jfif',
      'major-9': '/assets/cards/9-The-Hermit.jfif',
    };

    const root = document.getElementById('reading-tool');
  if (root) {
    const locale = (root.getAttribute('data-locale') || 'en') as 'en' | 'es' | 'fr';
    const stage = document.getElementById('stage') as HTMLElement;
    const introPanel = document.querySelector('[data-state-panel="intro"]') as HTMLElement;
    const loadingPanel = document.getElementById('stage-loading') as HTMLElement;
    const readingPanel = document.getElementById('stage-reading') as HTMLElement;
    const actionsPanel = document.getElementById('stage-actions') as HTMLElement;
    const acceptedPanel = document.getElementById('stage-accepted') as HTMLElement | null;
    const drawBtn = document.getElementById('draw-btn') as HTMLButtonElement | null;
    const rejectBtn = document.getElementById('reject-btn') as HTMLButtonElement;
    const acceptBtn = document.getElementById('accept-btn') as HTMLButtonElement;
    const readingControls = document.getElementById('reading-controls') as HTMLElement;
    const lockedCta = document.getElementById('locked-cta') as HTMLElement;
    const remainingText = document.getElementById('remaining-text') as HTMLElement;
    const remainingPill = document.getElementById('remaining-pill') as HTMLElement;
    const narrativeEl = document.getElementById('reading-narrative') as HTMLElement;
    const cardGrid = document.getElementById('card-grid') as HTMLElement;
    const dlg = document.getElementById('reject-confirm') as HTMLDialogElement;

    const REMAINING_COPY: Record<'en' | 'es' | 'fr', (n: number) => string> = {
      en: (n) => `${n}/2 rejections left`,
      es: (n) => `${n}/2 rechazos restantes`,
      fr: (n) => `${n}/2 refus restants`,
    };

    let currentReading: { cards: DrawCard[]; reading: Reading } | null = null;
    let remaining = 2;
    let flipTimer: number | null = null;

    function setState(s: State) {
      stage.dataset.state = s;
      // The intro panel contains the card grid. Once we've drawn, paintCards()
      // replaces its static card backs with the real flipped cards, so the
      // panel needs to stay visible in the accepted state too — only the
      // "Get a reading" button inside it gets hidden via CSS.
      introPanel.hidden = s !== 'intro' && s !== 'accepted';
      loadingPanel.hidden = s !== 'loading';
      readingPanel.hidden = s !== 'reading';
      actionsPanel.hidden = s !== 'reading';
      if (acceptedPanel) acceptedPanel.hidden = s !== 'accepted';
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function paintCards(cards: DrawCard[]) {
      cardGrid.innerHTML = cards
        .map((c) => {
          const art = IMAGE_BY_ID[c.card.id] || '';
          return `
        <div class="tarot-card" data-card-id="${c.card.id}" data-position="${escapeHtml(c.position.name)}">
          <div class="tarot-card-inner">
            <div class="tarot-card-face tarot-card-back">
              <img src="/assets/cards/back.jfif" alt="" loading="lazy" />
            </div>
            <div class="tarot-card-face tarot-card-front${c.orientation === 'reversed' ? ' is-reversed' : ''}">
              ${art ? `<img class="card-art" src="${art}" alt="${escapeHtml(c.card.name)}" loading="lazy" onerror="this.style.display='none'" />` : ''}
              <div class="card-overlay">
                <span class="position">${escapeHtml(c.position.name)}</span>
                <div class="card-name-row">
                  <span class="name">${escapeHtml(c.card.name)}</span>
                </div>
                <span class="orientation">${c.orientation}</span>
              </div>
            </div>
          </div>
        </div>`;
        })
        .join('');
    }

    function flipCards(stagger = true) {
      const cards = cardGrid.querySelectorAll<HTMLElement>('.tarot-card');
      cards.forEach((c, i) => {
        const delay = stagger ? i * 130 : 0;
        setTimeout(() => c.classList.add('is-flipped'), delay);
      });
    }

    function buildNarrative(rd: Reading, _cards: DrawCard[]): string {
      const parts: string[] = [];
      const summary = (rd.summary || '').trim();
      const story = (rd.story || '').trim();
      const advice = (rd.advice || '').trim();

      if (summary) parts.push(`<p class="lede">${escapeHtml(summary)}</p>`);

      if (story) {
        const paragraphs = story
          .split(/\n\s*\n+/)
          .map((p) => p.trim())
          .filter(Boolean);
        const source = paragraphs.length ? paragraphs : [story];
        source.forEach((para, i) => {
          const cls = i === 0 ? 'story story-first' : 'story';
          parts.push(`<p class="${cls}">${escapeHtml(para).replace(/\n/g, '<br/>')}</p>`);
        });
      } else if (rd.positionInterpretations && rd.positionInterpretations.length) {
        // Backwards compatibility for fallback / older shapes.
        rd.positionInterpretations.forEach((p) => {
          parts.push(
            `<p class="story"><strong>${escapeHtml(p.card)}.</strong> ${escapeHtml(p.text)}</p>`,
          );
        });
      }

      if (advice) parts.push(`<p class="advice"><em>Advice.</em> ${escapeHtml(advice)}</p>`);
      return parts.join('\n');
    }

    function renderReading(rd: Reading, cards: DrawCard[]) {
      narrativeEl.innerHTML = buildNarrative(rd, cards);
      narrativeEl.hidden = false;
    }

    function updateRemainingPill() {
      remainingText.textContent = REMAINING_COPY[locale](remaining);
      remainingPill.classList.toggle('is-locked', remaining <= 0);
    }

    function applyLimitState() {
      if (remaining <= 0) {
        readingControls.hidden = true;
        lockedCta.hidden = false;
      } else {
        readingControls.hidden = false;
        lockedCta.hidden = true;
      }
    }

    async function api<T>(path: string, init?: RequestInit): Promise<T> {
      const res = await fetch(path, { credentials: 'include', ...init });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const err: any = new Error(data?.error || res.statusText);
        err.status = res.status;
        err.body = data;
        throw err;
      }
      return data as T;
    }

    async function refreshLimit() {
      const data = await api<{ remaining: number; day: string; resetAtIso: string }>('/api/limit');
      remaining = data.remaining;
      if (remaining <= 0) {
        showLock(data.resetAtIso);
        return false;
      }
      updateRemainingPill();
      return true;
    }

    function showLock(resetAtIso: string) {
      setState('locked');
      stage.insertAdjacentHTML(
        'beforeend',
        `<div class="lock-state" id="inline-lock">
          <h2>Your reading is set</h2>
          <p>Come back tomorrow for a fresh draw. The cards will be waiting.</p>
          <div class="countdown" id="inline-countdown">
            <div class="countdown-unit"><span class="num" data-h>00</span><span class="lbl">Hours</span></div>
            <div class="countdown-unit"><span class="num" data-m>00</span><span class="lbl">Minutes</span></div>
            <div class="countdown-unit"><span class="num" data-s>00</span><span class="lbl">Seconds</span></div>
          </div>
        </div>`,
      );
      const target = new Date(resetAtIso).getTime();
      const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');
      function tick() {
        const diff = Math.max(0, target - Date.now());
        const h = Math.floor(diff / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        const c = document.getElementById('inline-countdown');
        if (!c) return;
        c.querySelector('[data-h]')!.textContent = pad(h);
        c.querySelector('[data-m]')!.textContent = pad(m);
        c.querySelector('[data-s]')!.textContent = pad(s);
        if (diff <= 0) location.reload();
      }
      tick();
      window.setInterval(tick, 1000);
    }

    async function startDraw() {
      // Hard guard: only allow a fresh draw when the stage is in the intro state.
      // This blocks re-entry via DevTools tampering or rapid double-clicks.
      if (stage.dataset.state !== 'intro') {
        return;
      }
      // Block only when the user has EXPLICITLY accepted a reading today.
      // A user who drew but didn't accept can still use a rejection.
      if (hasAcceptedToday()) {
        return;
      }
      const ok = await refreshLimit();
      if (!ok) return;
      await doDraw();
    }

    if (drawBtn) {
      drawBtn.addEventListener('click', startDraw);
    }

    async function doDraw(opts: { reject?: boolean } = {}) {
      setState('loading');
      try {
        const data = await api<{ cards: DrawCard[]; reading: Reading; remaining: number; accepted?: boolean }>(
          `/api/reading?action=${opts.reject ? 'reject' : 'draw'}`,
          {
            method: 'POST',
            body: JSON.stringify({ locale }),
          },
        );
        currentReading = data;
        remaining = data.remaining;
        paintCards(data.cards);
        setState('reading');
        updateRemainingPill();
        applyLimitState();
        flipCards(true);
        if (flipTimer) window.clearTimeout(flipTimer);
        flipTimer = window.setTimeout(() => renderReading(data.reading, data.cards), 9 * 130 + 250);
        saveToLocal(data);
      } catch (e: any) {
        if (e.status === 429) {
          showLock(e.body?.resetAtIso || new Date(Date.now() + 3600000).toISOString());
        } else if (e.status === 400) {
          alert('The reading service could not be reached right now. Please try again in a moment.');
          setState('intro');
        } else if (e.status === 402) {
          alert('The reading service had a problem. Please try again in a moment.');
          setState('intro');
        } else {
          alert('Could not reach the reading service. Please try again.');
          setState('intro');
        }
      }
    }

    rejectBtn.addEventListener('click', () => {
      if (remaining <= 0) {
        return;
      }
      (dlg as any).showModal ? (dlg as any).showModal() : (dlg.setAttribute('open', ''));
    });

    document.getElementById('reject-cancel')?.addEventListener('click', (ev) => {
      ev.preventDefault();
      (dlg as any).close ? (dlg as any).close() : dlg.removeAttribute('open');
    });

    document.getElementById('reject-confirm-btn')?.addEventListener('click', async (ev) => {
      ev.preventDefault();
      (dlg as any).close ? (dlg as any).close() : dlg.removeAttribute('open');
      await doDraw({ reject: true });
    });

    function cardFingerprint(cards: DrawCard[] | undefined): string {
      if (!cards || !cards.length) return '';
      return cards
        .map((c) => `${c.card.id}:${c.orientation}`)
        .join('|')
        .slice(0, 128);
    }

    acceptBtn.addEventListener('click', async () => {
      if (!currentReading) return;
      if (currentReading) saveToLocal(currentReading);
      markAcceptedToday();
      // Mark accepted server-side so any subsequent draw attempt is rejected.
      try {
        await api('/api/reading?action=accept', {
          method: 'POST',
          body: JSON.stringify({
            cardFingerprint: cardFingerprint(currentReading.cards),
            locale,
          }),
        });
      } catch {
        // Even if the server-side call fails, the client still remembers the accept.
      }
      setState('accepted');
      startAcceptedCountdown();
    });

    // Live countdown to UTC midnight, then auto-reload so the user wakes
    // up to a fresh draw button. The tick is a no-op once the page reloads.
    let acceptedTimer: number | null = null;
    function startAcceptedCountdown() {
      // Compute next UTC midnight (server's "today" rolls over at UTC, not local).
      const now = new Date();
      const next = new Date(Date.UTC(
        now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 1, 0, 0, 0, 0,
      ));
      const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');
      const tick = () => {
        const diff = next.getTime() - Date.now();
        const h = pad(Math.floor(diff / 3600000));
        const m = pad(Math.floor((diff % 3600000) / 60000));
        const s = pad(Math.floor((diff % 60000) / 1000));
        const el = document.getElementById('accepted-countdown');
        if (el) el.textContent = `${h}:${m}:${s}`;
        if (diff <= 0) {
          if (acceptedTimer) window.clearInterval(acceptedTimer);
          location.reload();
        }
      };
      tick();
      acceptedTimer = window.setInterval(tick, 1000);
    }

    function saveToLocal(data: { cards: DrawCard[]; reading: Reading }) {
      try {
        const today = new Date().toISOString().slice(0, 10);
        localStorage.setItem(
          `dt_reading_${today}`,
          JSON.stringify({ cards: data.cards, reading: data.reading, savedAt: Date.now() }),
        );
      } catch (_) {}
    }

    function readSavedReading(): { cards: DrawCard[]; reading: Reading } | null {
      try {
        const today = new Date().toISOString().slice(0, 10);
        const raw = localStorage.getItem(`dt_reading_${today}`);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        return parsed?.cards && parsed?.reading ? parsed : null;
      } catch {
        return null;
      }
    }

    // The user has EXPLICITLY accepted a reading today — locks the stage
    // until tomorrow so they can't burn another reject on something they
    // already saved. Distinct from `readSavedReading`, which only means
    // "we drew cards" (the user can still reject and re-draw in that case).
    function hasAcceptedToday(): boolean {
      try {
        const today = new Date().toISOString().slice(0, 10);
        return localStorage.getItem(`dt_accepted_${today}`) === '1';
      } catch {
        return false;
      }
    }

    function markAcceptedToday() {
      try {
        const today = new Date().toISOString().slice(0, 10);
        localStorage.setItem(`dt_accepted_${today}`, '1');
      } catch (_) {}
    }

    (function restoreOrLock() {
      // If the user accepted a reading today, go straight to the Accepted
      // state with the live countdown. No "draw again" path from here.
      if (hasAcceptedToday()) {
        const saved = readSavedReading();
        if (saved) {
          currentReading = saved;
          paintCards(saved.cards);
        }
        // Cards flip immediately on restore (no stagger) so the user sees
        // the spread they accepted, then the Saved panel slides in below.
        flipCards(false);
        setState('accepted');
        startAcceptedCountdown();
        return;
      }
      // Otherwise: if there's a drawn-but-not-accepted reading, restore it.
      refreshLimit()
        .then((ok) => {
          if (!ok) return;
          const saved = readSavedReading();
          if (saved) {
            currentReading = saved;
            paintCards(saved.cards);
            setState('reading');
            updateRemainingPill();
            applyLimitState();
            flipCards(true);
            if (flipTimer) window.clearTimeout(flipTimer);
            flipTimer = window.setTimeout(() => renderReading(saved.reading, saved.cards), 0);
          }
        })
        .catch(() => {});
    })();
  }
</script>
