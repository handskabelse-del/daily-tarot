---
// Hamburger menu button + off-canvas drawer for mobile navigation.
// Hidden on desktop (>= 881px) via CSS. The desktop nav is rendered
// directly in BaseLayout.astro.
---
<button
  class="menu-toggle"
  type="button"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="mobile-nav"
  data-menu-toggle
>
  <span class="menu-toggle-icon" aria-hidden="true">
    <span class="bar bar-1"></span>
    <span class="bar bar-2"></span>
    <span class="bar bar-3"></span>
  </span>
</button>

<div
  class="mobile-nav-backdrop"
  data-menu-backdrop
  hidden
></div>

<nav
  class="mobile-nav"
  id="mobile-nav"
  aria-label="Mobile primary"
  data-menu-nav
  hidden
>
  <div class="mobile-nav-header">
    <span class="mobile-nav-title">Daily Tarot</span>
    <button
      class="mobile-nav-close"
      type="button"
      aria-label="Close menu"
      data-menu-close
    >×</button>
  </div>
  <div class="mobile-nav-links">
    <a href="/" data-menu-link>Reading</a>
    <a href="/card-of-the-day" data-menu-link>Card of the day</a>
    <a href="/tarot-card-meanings" data-menu-link>Card meanings</a>
    <a href="/blog" data-menu-link>Blog</a>
    <div class="mobile-nav-divider" role="separator"></div>
    <a href="/es/" data-menu-link lang="es">Español</a>
    <a href="/fr/" data-menu-link lang="fr">Français</a>
  </div>
</nav>

<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-menu-toggle]');
    const nav = document.querySelector('[data-menu-nav]');
    const backdrop = document.querySelector('[data-menu-backdrop]');
    const close = document.querySelector('[data-menu-close]');
    const links = document.querySelectorAll('[data-menu-link]');
    if (!toggle || !nav || !backdrop || !close) return;

    let isOpen = false;

    function open() {
      isOpen = true;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      nav.hidden = false;
      backdrop.hidden = false;
      // Defer to next frame so the transition has a starting state.
      requestAnimationFrame(() => {
        nav.classList.add('is-open');
        backdrop.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';
      // Focus the close button for keyboard users.
      close.focus();
    }

    function closeMenu() {
      isOpen = false;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      nav.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      document.body.style.overflow = '';
      // Wait for the transition to finish before hiding (avoids jank).
      const onEnd = () => {
        if (!isOpen) {
          nav.hidden = true;
          backdrop.hidden = true;
        }
        nav.removeEventListener('transitionend', onEnd);
      };
      nav.addEventListener('transitionend', onEnd);
      toggle.focus();
    }

    toggle.addEventListener('click', () => (isOpen ? closeMenu() : open()));
    close.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    // Close on any nav link click.
    links.forEach((a) => a.addEventListener('click', closeMenu));

    // Close on Escape.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeMenu();
    });

    // Close if window grows past the mobile breakpoint.
    const mq = window.matchMedia('(min-width: 881px)');
    mq.addEventListener('change', (e) => {
      if (e.matches && isOpen) closeMenu();
    });
  })();
</script>