---
export interface Props {
  slot: 'top' | 'infeed' | 'sidebar';
}
const { slot } = Astro.props;
const clientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || '';
const adId = slot === 'top' ? '1111111111' : slot === 'infeed' ? '2222222222' : '3333333333';
const adFormat = slot === 'top' ? 'auto' : 'fluid';
---
<div class="ad-slot-wrapper" data-ad-slot={slot}>
  {clientId ? (
    <ins
      class="adsbygoogle ad-slot"
      data-ad-client={clientId}
      data-ad-slot={adId}
      data-ad-format={adFormat}
      data-full-width-responsive="true"
      style="display:block"
    ></ins>
  ) : (
    <div class="ad-slot" aria-label="Advertisement placeholder">
      <span class="ad-slot-label">Advertisement</span>
    </div>
  )}
</div>